# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tsconfig.tsbuildinfo

# Android / Bubblewrap TWA build (see "Installing as an Android app" in the README) —
# generated by `bubblewrap init`/`build` and safe to regenerate; android.keystore is
# the private signing key and must never be committed.
android.keystore
*.apk
*.apk.idsig
*.aab
/app
/gradle
/dist
.gradle
gradlew
gradlew.bat
build.gradle
gradle.properties
settings.gradle
store_icon.png
manifest-checksum.txt
/assetlinks.json
